# 複製成 .env.local 後填入。這個檔案不含任何真實金鑰，.env.local 不會進版本控制。

# Gemini：到 Google AI Studio 建立金鑰
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 每個協會每月的 AI 呼叫上限，超過就停止呼叫，避免費用失控
AI_MONTHLY_CALL_CAP=3000

# 本站對外網址（LINE 選單連結用），不要加結尾斜線
APP_URL=http://localhost:3100

# 登入用的簽章密鑰，正式環境必填，可用 openssl rand -hex 32 產生
SESSION_SECRET=

# 示範協會的管理者密碼（只在寫入示範資料時使用）
DEMO_MANAGER_PASSWORD=langlang-demo

# 以下三個留空時用本機檔案，不需要 Google Cloud
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# LINE：只有執行 scripts/setup-line.ts 時會讀，之後存在資料庫的私密區
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
