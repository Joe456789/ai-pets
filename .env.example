# 複製成 .env.local 後填入。這個檔案不含任何真實金鑰，.env.local 不會進版本控制。

# Gemini：到 Google AI Studio 建立金鑰（用真實飼主資料前要改付費方案）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 全平台、每位飼主、公開評估頁每月的 AI 呼叫上限
AI_MONTHLY_CALL_CAP=3000
AI_OWNER_MONTHLY_CAP=80
AI_PUBLIC_MONTHLY_CAP=500

# 本站對外網址，不要加結尾斜線
APP_URL=

# 登入用的簽章密鑰，正式環境必填，可用 openssl rand -hex 32 產生
SESSION_SECRET=

# 留空時用本機檔案，不需要 Google Cloud
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# LINE 官方帳號（Messaging API）：npm run setup:line 時會讀，之後存在資料庫的私密區
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login 頻道（同一個 Provider）與 LIFF
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
# 加好友網址（https://lin.ee/…）
LINE_ADD_URL=

# 3D 工作站和每日提醒排程用的密鑰（各 24 字元以上）
WORKER_TOKEN=
CRON_SECRET=
