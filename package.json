{
  "name": "langlang-partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "render:richmenu": "node scripts/render-rich-menus.mjs",
    "setup:line": "tsx --env-file=.env.local scripts/setup-line.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "seed:history": "tsx --env-file=.env.local scripts/seed-history.ts",
    "warm:on": "gcloud run services update langlang-partner --project langlang-partner-2026 --region asia-east1 --min-instances 1",
    "warm:off": "gcloud run services update langlang-partner --project langlang-partner-2026 --region asia-east1 --min-instances 0",
    "dev:local": "set LL_LOCAL_DATA=1&& next dev -p 3100",
    "demo:refresh": "tsx --env-file=.env.local scripts/refresh-demo.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^2.32.0",
    "@google/model-viewer": "4.3.1",
    "@mediapipe/tasks-vision": "0.10.35",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "0.183.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.183.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
